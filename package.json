{
  "name": "pas-a-pas-french",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run audio:verify && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "audio:verify": "node scripts/verify-french-audio-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "audit:production": "npm audit --omit=dev --audit-level=low",
    "audit:all": "npm audit --audit-level=low",
    "licenses:verify": "node scripts/verify-production-licenses.mjs",
    "version:verify": "node scripts/verify-release-version.mjs",
    "db:verify": "node --disable-warning=ExperimentalWarning scripts/verify-sqlite-migrations.mjs",
    "release:artifact": "node scripts/verify-release-artifact.mjs",
    "release:verify": "npm run typecheck && npm run lint && npm run audit:production && npm run audit:all && npm run licenses:verify && npm run version:verify && npm run db:verify && npm test && npm run release:artifact"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.1",
    "@cloudflare/workers-types": "5.20260719.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "axe-core": "^4.11.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^27.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "vitest": "^3.2.7",
    "wrangler": "4.112.0"
  },
  "overrides": {
    "postcss": "8.5.14",
    "@babel/core": "7.29.6",
    "js-yaml": "4.3.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
