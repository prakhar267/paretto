{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "__CLOUDFLARE_ACCOUNT_ID__",
  "name": "paretto",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ADMIN_EMAILS": "__ADMIN_EMAIL__",
    "NATIVE_API_ENABLED": "false",
    "TURNSTILE_SITE_KEY": "__TURNSTILE_SITE_KEY__"
  },
  "secrets": {
    "required": [
      "USER_KEY_SECRET",
      "ADMIN_PASSWORD_VERIFIER",
      "ADMIN_SESSION_SECRET",
      "TURNSTILE_SECRET"
    ]
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/accessibility",
      "/admin",
      "/admin/*",
      "/api/*",
      "/attributions",
      "/cookies",
      "/privacy",
      "/support",
      "/terms"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__D1_DATABASE_NAME__",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
