{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "__CLOUDFLARE_ACCOUNT_ID__",
  "name": "paretto",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ADMIN_EMAILS": "__ADMIN_EMAILS__",
    "AUTH_EMAIL_FROM": "__AUTH_EMAIL_FROM__",
    "BETTER_AUTH_URL": "__BETTER_AUTH_URL__",
    "LAUNCH_MODE": "__LAUNCH_MODE__",
    "NATIVE_API_ENABLED": "false",
    "SUPPORT_NOTIFICATION_EMAIL": "__SUPPORT_NOTIFICATION_EMAIL__",
    "TURNSTILE_SITE_KEY": "__TURNSTILE_SITE_KEY__",
    "WORKERS_PLAN": "__WORKERS_PLAN__"
  },
  "secrets": {
    "required": [
      "USER_KEY_SECRET",
      "SUPPORT_RATE_LIMIT_SECRET",
      "BETTER_AUTH_RATE_LIMIT_SECRET",
      "BETTER_AUTH_SECRET",
      "PARETTO_PASSWORD_PEPPERS",
      "__ADMIN_PASSWORD_SECRET_NAME__",
      "ADMIN_SESSION_SECRET",
      "TURNSTILE_SECRET"
    ]
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/accessibility",
      "/admin",
      "/admin/*",
      "/api/*",
      "/auth/*",
      "/attributions",
      "/cookies",
      "/privacy",
      "/reset-password",
      "/sign-in",
      "/support",
      "/terms"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__D1_DATABASE_NAME__",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
